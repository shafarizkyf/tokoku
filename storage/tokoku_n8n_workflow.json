    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Use a FIXED namespace (must never change)\nconst NAMESPACE = 'n8n-chat-session';\n\n// Your sessionId from Chat Trigger\nconst sessionId = $input.first().json.sessionId;\n\n// UUID v5 implementation\nfunction uuidv5(name, namespace) {\n  const hash = crypto\n    .createHash('sha1')\n    .update(namespace + name)\n    .digest('hex');\n\n  return [\n    hash.substring(0, 8),\n    hash.substring(8, 12),\n    '5' + hash.substring(13, 16), // version 5\n    ((parseInt(hash.substring(16, 17), 16) & 0x3) | 0x8).toString(16) +\n      hash.substring(17, 20),\n    hash.substring(20, 32),\n  ].join('-');\n}\n\nreturn {\n  uuid: uuidv5(sessionId, NAMESPACE),\n};\n"
      },
